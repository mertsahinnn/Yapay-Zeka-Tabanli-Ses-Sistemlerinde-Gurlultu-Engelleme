# ================================================
# Keep these files
# ================================================
# Keep specific important files even if they match patterns above
!requirements.txt
!README.md
!LICENSE
!.gitignore
!docker-compose.yml
!Dockerfile
!setup.py
!pyproject.toml

# Keep sample configuration files
